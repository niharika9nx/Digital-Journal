{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile and metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Authentication User ID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "createdAt", "updatedAt"]
    },
    "Session": {
      "title": "Session",
      "description": "User reflection or conversational journal session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique session identifier"
        },
        "uid": {
          "type": "string",
          "description": "Owner user UID"
        },
        "title": {
          "type": "string",
          "description": "Session title or topic"
        },
        "content": {
          "type": "string",
          "description": "Journal text or initial reflection content"
        },
        "mood": {
          "type": "string",
          "description": "Session mood tag"
        },
        "tags": {
          "type": "array",
          "description": "Optional categorization tags"
        },
        "messages": {
          "type": "array",
          "description": "Multi-turn conversation history between user and Gemini model"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Session creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "uid", "createdAt", "updatedAt"]
    },
    "Summary": {
      "title": "Summary",
      "description": "Deterministic RAG summary and emotional valence metric generated by Gemini",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique summary identifier"
        },
        "uid": {
          "type": "string",
          "description": "Owner user UID"
        },
        "sessionId": {
          "type": "string",
          "description": "Referenced session identifier"
        },
        "summaryText": {
          "type": "string",
          "description": "Dense objective summary generated for RAG context"
        },
        "keyThemes": {
          "type": "array",
          "description": "Key topical keywords and recurring themes"
        },
        "emotionalValence": {
          "type": "number",
          "description": "Float score from -1.0 to +1.0"
        },
        "mood": {
          "type": "string",
          "description": "Classification of emotional tone"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Summary creation timestamp"
        }
      },
      "required": ["id", "uid", "sessionId", "summaryText", "keyThemes", "emotionalValence", "mood", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Private user account record, strictly isolated to the authenticated owner"
    },
    "/users/{uid}/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Private reflection and conversational journal sessions scoped strictly to the authenticated owner"
    },
    "/users/{uid}/summaries/{summaryId}": {
      "schema": "Summary",
      "description": "Private objective summaries and emotional valence metrics scoped strictly to the authenticated owner"
    }
  }
}
